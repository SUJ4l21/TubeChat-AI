{
  "manifest_version": 3,
  "name": "TubeChat AI",
  "version": "1.0",
  "description": "Chat with any YouTube video.",
  "permissions": ["activeTab"],
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "192": "icons/icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png",
      "192": "icons/icon.png"
    }
  }
}
